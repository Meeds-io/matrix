<% def palette = org.exoplatform.commons.notification.mail.MailPalette.of(_templateContext) %>
<table border="0" cellpadding="0" cellspacing="0" width="600" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 12px;color:${palette.text};line-height: 18px;font-family: HelveticaNeue, Helvetica, Arial, sans-serif;" class="mail-surface mail-text">
    <%
      _templateContext.put("header_title", _ctx.appRes("UINotification.title.MatrixMentionReceivedNotificationPlugin"));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
            <table cellpadding="0" cellspacing="0" width="100%"  bgcolor="${palette.surface}" style="background-color: ${palette.surface}; border-bottom:1px solid ${palette.border};border-left:1px solid ${palette.border};border-right:1px solid ${palette.border};" class="mail-surface mail-border">
                <tr>
                    <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
                        <table border="0" cellpadding="0" cellspacing="0" width="92%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 12px;color:${palette.text};line-height: 18px;" class="mail-surface mail-text">
                            <tr>
                                <td valign="top" width="90px">
                                    <img width="75px" height="75px" src="$AVATAR" alt="$USER" />
                                </td>
                                <td align="left" bgcolor="${palette.surface}" style="background-color: ${palette.surface};padding: 10px 0;" class="mail-surface">
                                    <p style="margin: 10px 0;"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                    <p style="margin: 10px 0 13px;">
                                    <%
                                      String message = "";
                                      String profileUrl = "<strong><a target=\"_blank\" style=\"color: ${palette.link}; text-decoration: none; font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif\" href=\""+ PROFILE_URL + "\" class=\"mail-link\">" + _ctx.escapeHTML(USER) + "</a></strong>";
                                      String roomUrl = "<strong><a target=\"_blank\" style=\"color: ${palette.link}; text-decoration: none; font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif\" href=\""+ MESSAGE_LINK + "\" class=\"mail-link\">" + _ctx.escapeHTML(ROOM) + "</a></strong>";
                                      if (ROOM_TYPE.equals("SPACE")) {
                                        message = _ctx.appRes("Notification.body.space.MentionReceivedNotificationPlugin", profileUrl, roomUrl);
                                      } else {
                                        message = _ctx.appRes("Notification.body.onetoone.MentionReceivedNotificationPlugin", profileUrl, roomUrl);
                                      }
                                    %>
                                    <%=message%>
                                      <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 12px;color:${palette.text};line-height: 18px; margin-bottom: 15px;" class="mail-surface mail-text">
                                          <tbody>
                                              <tr>
                                                  <td align="left" bgcolor="${palette.surface}" style="background-color: ${palette.background}; padding: 15px 20px;" class="mail-bg">
                                                      <p style="margin: 5px 0; line-height: 16px; font-family: HelveticaNeue, Helvetica, Arial, sans-serif; color: ${palette.text}" class="mail-text">$MESSAGE_CONTENT</p>
                                                  </td>
                                              </tr>
                                          </tbody>
                                      </table>
                                      <br/>
                                      <p style="margin: 0 0 20px;">
                                          <a target="_blank" style="
                                              display: inline-block;
                                              text-decoration: none;
                                              font-size: 11px;
                                              font-family: HelveticaNeue, Helvetica, Arial, sans-serif,serif;
                                              color: ${palette.text};
                                              background-color: ${palette.background};
                                              background-repeat: repeat-x;
                                              border-radius: 4px;
                                              -moz-border-radius: 4px;
                                              padding: 5px 8px;
                                              height: 11px;
                                              line-height: 12px;
                                              max-height: 11px;
                                              text-align: center;
                                              border: 1px solid ${palette.border};
                                              -webkit-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                              -moz-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                              box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                              vertical-align: middle;
                                              margin-left: 3px;
                                          " href="$MESSAGE_LINK" target="_blank" class="mail-text mail-bg mail-border"><%=_ctx.appRes("Notification.label.openRoom")%></a>
                                      </p>
                                    <p style="margin: 0 0 10px; color: ${palette.secondaryText}" class="mail-secondary-text">
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>            
        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>